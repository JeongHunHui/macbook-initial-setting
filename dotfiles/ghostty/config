macos-option-as-alt = left
font-family = JetBrains Mono
mouse-scroll-multiplier = 0.5
link-url = true
working-directory = __HOME__/Projects
keybind = shift+enter=csi:13;2u
keybind = cmd+arrow_left=text:\x01
keybind = cmd+arrow_right=text:\x05
keybind = cmd+arrow_up=unbind
keybind = cmd+arrow_down=unbind
keybind = cmd+shift+arrow_up=unbind
keybind = cmd+shift+arrow_down=unbind
keybind = cmd+d=ignore
keybind = cmd+shift+d=ignore
# Disable unexpected clear, split, and prompt-jump actions while editing.
keybind = cmd+k=ignore
keybind = cmd+j=ignore
keybind = cmd+enter=ignore
keybind = cmd+shift+enter=ignore
keybind = cmd+[=ignore
keybind = cmd+]=ignore
keybind = cmd+alt+arrow_up=ignore
keybind = cmd+alt+arrow_down=ignore
keybind = cmd+alt+arrow_left=ignore
keybind = cmd+alt+arrow_right=ignore
keybind = cmd+ctrl+arrow_up=ignore
keybind = cmd+ctrl+arrow_down=ignore
keybind = cmd+ctrl+arrow_left=ignore
keybind = cmd+ctrl+arrow_right=ignore
keybind = cmd+ctrl+==ignore
keybind = cmd+shift+j=ignore
keybind = cmd+ctrl+shift+j=ignore
keybind = cmd+alt+shift+j=ignore
keybind = cmd+alt+shift+w=ignore
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
keybind = alt+arrow_up=unbind
keybind = alt+arrow_down=unbind
